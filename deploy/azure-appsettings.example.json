{
  "ASPNETCORE_ENVIRONMENT": "Production",
  "ASPNETCORE_HTTP_PORTS": "8080",
  "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
  "AllowedHosts": "REPLACE_WITH_BACKEND_HOST.azurecontainerapps.io",
  "Cors__Origins__0": "https://REPLACE_WITH_FRONTEND.azurestaticapps.net",
  "ConnectionStrings__SqlServer": "Server=tcp:hrcms.database.windows.net,1433;Database=HRCMS;User ID=hrcms;Password=REPLACE_WITH_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30",
  "Database__Provider": "SqlServer",
  "Database__AutoMigrate": "false",
  "Storage__Provider": "AzureBlob",
  "Storage__IdentityCredential": "Default",
  "Storage__ServiceUri": "https://hrcmsg2.blob.core.windows.net/",
  "Storage__Container": "hrcms-files",
  "DataProtection__Path": "/mnt/hrcms-keys",
  "DataProtection__KeyEncryption": "Certificate",
  "DataProtection__RequireEncryptedKeys": "true",
  "DataProtection__CertificateBase64": "REPLACE_WITH_PFX_FILE_BASE64",
  "DataProtection__CertificatePassword": "REPLACE_WITH_PFX_PASSWORD",
  "Workers__Enabled": "true",
  "Email__Provider": "Smtp",
  "Email__FromAddress": "REPLACE_WITH_SENDER_EMAIL",
  "Email__Smtp__Host": "smtp.gmail.com",
  "Email__Smtp__Port": "587",
  "Email__Smtp__EnableSsl": "true",
  "Email__Smtp__Username": "REPLACE_WITH_SENDER_EMAIL",
  "Email__Smtp__Password": "REPLACE_WITH_SMTP_APP_PASSWORD"
}
